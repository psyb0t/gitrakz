# Published image + tag the local stack runs. The installer pins this to the
# latest release tag; `gitrakz upgrade` re-pins it. `gitrakz start --rolling`
# overrides it with the moving :latest for that one run only.
GITRAKZ_IMAGE=psyb0t/gitrakz:latest

# Host interface + port the container's 8080 is published on (loopback-only by
# default — front it with a reverse proxy / tailnet to expose it beyond localhost).
GITRAKZ_PUBLISH_ADDR=127.0.0.1
GITRAKZ_PUBLISH_PORT=8080

# Bearer token required to authenticate HTTP API requests (empty disables auth).
GITRAKZ_AUTH_TOKEN=

# GitHub username whose activity gitrakz tracks. Optional — defaults to the gh
# CLI's authenticated login; set it to track another user.
GITRAKZ_GH_USER=

# Earliest date (YYYY-MM-DD) to sync GitHub activity from.
GITRAKZ_SYNC_SINCE=2025-01-01

# Interval between automatic sync runs (0 disables automatic sync, manual only).
GITRAKZ_SYNC_INTERVAL=30m

# Maximum gap between events before a new coding session is started.
GITRAKZ_SESSION_GAP=30m

# Lead-in time added before a session's first event.
GITRAKZ_SESSION_LEADIN=25m

# LLM provider driver: openai (also OpenAI-compatible endpoints) or anthropic.
GITRAKZ_ELELEM_TYPE=openai

# API host of the LLM provider used for summarization.
GITRAKZ_ELELEM_BASE_URL=

# LLM model name used for summarization.
GITRAKZ_ELELEM_MODEL=

# API key for the LLM provider.
GITRAKZ_ELELEM_API_KEY=

# GH_TOKEN is intentionally NOT set here. It authenticates gitrakz's `gh` calls
# and is injected at runtime, never persisted to disk: the `gitrakz` wrapper
# captures it with `gh auth token`, and a direct `docker compose` run expects it
# in the environment — run `export GH_TOKEN="$(gh auth token)"` first.
